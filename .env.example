# Copy to .env and enter the exact values provided by the organizers.
# Empty URL/model deliberately prevent requests until configured.
QWEN_BASE_URL=
QWEN_MODEL=
# Optional: leave empty if the organizer API requires no authentication.
QWEN_API_KEY=
# Positive number of seconds (default 180).
QWEN_TIMEOUT=180
# Positive integer: maximum output tokens for analysis/design (default 6500).
QWEN_MAX_TOKENS=6500
