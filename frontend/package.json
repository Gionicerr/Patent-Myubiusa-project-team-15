{
  "name": "notes",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve --configuration development --proxy-config proxy.conf.cjs",
    "start:mock": "ng serve --configuration mock",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:watch": "ng test --browsers=ChromeHeadlessNoSandbox",
    "test:e2e": "playwright test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "20.1.6",
    "@angular/compiler": "20.1.6",
    "@angular/core": "20.1.6",
    "@angular/forms": "20.1.6",
    "@angular/platform-browser": "20.1.6",
    "@angular/router": "20.1.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1",
    "@angular/material": "20.1.6",
    "@angular/cdk": "20.1.6"
  },
  "devDependencies": {
    "@angular/build": "20.1.6",
    "@angular/cli": "20.1.6",
    "@angular/compiler-cli": "20.1.6",
    "@types/jasmine": "5.1.15",
    "jasmine-core": "5.8.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.8.3",
    "@playwright/test": "1.56.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "npm": ">=10"
  }
}
