{
  "boundaries": "Учебное описание. Сценарий ограничен открытым PWA и mock-координатами. Приложение не создано.",
  "user_flows": [
    {
      "role": "Водитель",
      "steps": [
        "Открыть карту",
        "Получить зону",
        "Подтвердить сессию",
        "Получить предупреждение"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004",
        "FR-006"
      ]
    },
    {
      "role": "Администратор",
      "steps": [
        "Открыть историю",
        "Просмотреть события"
      ],
      "requirement_ids": [
        "FR-005"
      ]
    }
  ],
  "components": [
    {
      "name": "PWA и административные экраны",
      "responsibility": "Интерфейс водителя и администратора",
      "technology": "Angular 20.1.6"
    },
    {
      "name": "API",
      "responsibility": "Зоны, сессии, события и mock-адаптер",
      "technology": "ASP.NET Core / .NET 10 / C# 14"
    },
    {
      "name": "Хранилище",
      "responsibility": "Сессии, геометрии и история",
      "technology": "PostgreSQL 17.9 + PostGIS"
    }
  ],
  "data_model": [
    {
      "entity": "ParkingZone",
      "fields": [
        "id: UUID",
        "number: string",
        "geometry: Polygon, SRID 4326"
      ],
      "relations": []
    },
    {
      "entity": "ParkingSession",
      "fields": [
        "id: UUID",
        "driver_id: UUID",
        "zone_id: UUID",
        "ends_at: UTC timestamp"
      ],
      "relations": [
        "zone_id → ParkingZone.id"
      ]
    },
    {
      "entity": "ParkingEvent",
      "fields": [
        "id: UUID",
        "session_id: UUID",
        "type: string",
        "occurred_at: UTC timestamp"
      ],
      "relations": [
        "session_id → ParkingSession.id"
      ]
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/locations",
      "description": "Определить зону и смену зоны",
      "request": "latitude: -90..90; longitude: -180..180; timestamp: UTC",
      "response": "200: zoneId, zoneNumber, changed; 400: validation error",
      "auth": "Водитель, только свой автомобиль",
      "requirement_ids": [
        "FR-001",
        "FR-004"
      ]
    },
    {
      "method": "POST",
      "path": "/api/sessions",
      "description": "Подтвердить сессию",
      "request": "zoneId: UUID, endsAt: UTC в будущем, idempotencyKey: UUID",
      "response": "201: sessionId, endsAt; 409: конфликт сессии",
      "auth": "Водитель, только своя сессия",
      "requirement_ids": [
        "FR-002"
      ]
    },
    {
      "method": "GET",
      "path": "/api/history",
      "description": "История",
      "request": "from, to: UTC; limit: 1..100",
      "response": "200: sessions[], events[]; 403: недостаточно прав",
      "auth": "Администратор",
      "requirement_ids": [
        "FR-005"
      ]
    }
  ],
  "events": [
    {
      "name": "ParkingWarningDue",
      "schema": "version: 1; id: UUID; sessionId: UUID; occurredAt: UTC",
      "delivery": "Внутренний обработчик; дедупликация по sessionId и типу, Kafka не требуется"
    }
  ],
  "validation_and_errors": [
    "Проверять диапазон координат и формат времени",
    "При отсутствии координат не подтверждать нахождение в зоне",
    "Ошибки: code, message, fieldErrors, requestId"
  ],
  "security_recommendations": [
    "Проверять роль и принадлежность автомобиля на backend",
    "Не писать ключи и подробные маршруты в общедоступные логи"
  ],
  "test_scenarios": [
    {
