    },
    {
      "id": "TC-002",
      "requirement_ids": [
        "FR-002"
      ],
      "given": "Выбрана зона и будущее время окончания",
      "when": "Водитель подтвердил сессию",
      "then": "Сессия сохранена и доступна после повторного открытия",
      "type": "positive"
    },
    {
      "id": "TC-003",
      "requirement_ids": [
        "FR-003"
      ],
      "given": "Активная сессия и управляемые часы",
      "when": "Осталось ровно 10 минут",
      "then": "Создано одно предупреждение; повторная проверка не дублирует его",
      "type": "boundary"
    },
    {
      "id": "TC-004",
      "requirement_ids": [
        "FR-004"
      ],
      "given": "Автомобиль находился в зоне A",
      "when": "Подтверждена смена на зону B",
      "then": "Показана необходимость проверки новой оплаты, оплата не объявлена выполненной",
      "type": "positive"
    },
    {
      "id": "TC-005",
      "requirement_ids": [
        "FR-005"
      ],
      "given": "Сохранены сессия и событие",
      "when": "Администратор открыл историю",
      "then": "Записи видны в хронологическом порядке",
      "type": "positive"
    },
    {
      "id": "TC-006",
      "requirement_ids": [
        "FR-006"
      ],
      "given": "Подключен mock-адаптер",
