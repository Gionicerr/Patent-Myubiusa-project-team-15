{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "boundaries": {
      "type": "string",
      "minLength": 1
    },
    "user_flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      },
      "minItems": 1
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 1
    },
    "data_model": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 1
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/role"
      },
      "minItems": 1
    },
    "api": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      },
      "minItems": 1
    },
    "screens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screen"
      },
      "minItems": 1
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 0
    },
    "test_scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      },
      "minItems": 0
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "validation_and_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "security_recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "boundaries",
    "user_flows",
    "components",
    "data_model",
    "schemas",
    "roles",
    "api",
    "screens",
    "events",
    "test_scenarios",
    "assumptions",
    "open_questions",
    "validation_and_errors",
    "security_recommendations",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rwb:design:2.0",
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "name",
        "description",
        "required",
        "schema"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "target_entity": {
          "type": "string",
          "minLength": 1
        },
        "target_field": {
          "type": "string",
          "minLength": 1
        },
        "on_delete": {
          "enum": [
            "RESTRICT",
            "CASCADE",
            "SET NULL"
          ]
        }
      },
      "required": [
        "field",
        "target_entity",
        "target_field",
        "on_delete"
      ],
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "unique": {
          "type": "boolean"
        },
        "method": {
          "enum": [
            "btree",
            "gist",
            "gin"
          ]
        },
        "predicate": {
          "type": "object",
          "required": [
            "field",
            "operator",
            "value"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "operator": {
              "enum": [
                "eq",
                "in",
                "is_null"
              ]
            },
            "value": {}
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "fields",
        "unique",
        "method"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 1
        },
        "primary_key": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          },
          "minItems": 0
        },
        "constraints": {
          "type": "object",
          "properties": {
            "allOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              }
            },
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              }
            },
            "oneOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              }
            },
            "dependentRequired": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "description",
        "fields",
        "primary_key",
        "relations",
        "indexes"
      ],
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "in": {
          "enum": [
            "path",
            "query",
            "header"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "name",
        "in",
        "required",
        "description",
        "schema"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "pattern": "^[1-5][0-9]{2}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "oneOf": [
            {
              "type": "object",
              "minProperties": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "description",
        "schema"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FR-\\d{3,}$"
          },
          "minItems": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          },
          "minItems": 0
        },
        "request_body": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "schema": {
                  "type": "object",
                  "minProperties": 1
                }
              },
              "required": [
                "required",
                "schema"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/response"
          },
          "minItems": 1
        }
      },
      "required": [
        "operation_id",
        "method",
        "path",
        "summary",
        "roles",
        "requirement_ids",
        "parameters",
        "request_body",
        "responses"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation_id": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "enum": [
                  "own",
                  "assigned",
                  "all"
                ]
              }
            },
            "required": [
              "operation_id",
              "scope"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "permissions"
      ],
      "additionalProperties": false
    },
    "screen": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FR-\\d{3,}$"
          },
          "minItems": 1
        },
        "display_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "entity",
              "fields"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "operation_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label",
              "operation_id"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "states": {
          "type": "object",
          "properties": {
            "loading": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "type": "string",
              "minLength": 1
            },
            "empty": {
              "type": "string",
              "minLength": 1
            },
            "forbidden": {
              "type": "string",
              "minLength": 1
            },
            "ready": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "loading",
            "error",
            "empty",
            "forbidden",
            "ready"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "route",
        "name",
        "roles",
        "requirement_ids",
        "display_fields",
        "actions",
        "states"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FR-\\d{3,}$"
          },
          "minItems": 1
        },
        "schema": {
          "type": "object",
          "minProperties": 1
        },
        "id_field": {
          "type": "string",
          "minLength": 1
        },
        "time_field": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "delivery": {
          "enum": [
            "at_least_once",
            "at_most_once"
          ]
        },
        "deduplication": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "requirement_ids",
        "schema",
        "id_field",
        "time_field",
        "idempotency_key",
        "delivery",
        "deduplication"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC-\\d{3,}$"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FR-\\d{3,}$"
          },
          "minItems": 1
        },
        "operation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "given": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "then": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "positive",
            "negative",
            "boundary"
          ]
        }
      },
      "required": [
        "id",
        "requirement_ids",
        "operation_ids",
        "given",
        "when",
        "then",
        "type"
      ],
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A-\\d{3,}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "text",
        "reason"
      ],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FR-\\d{3,}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "role",
        "steps",
        "requirement_ids"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "responsibility": {
          "type": "string",
          "minLength": 1
        },
        "technology": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "responsibility",
        "technology"
      ],
      "additionalProperties": false
    }
  }
}
