        "method": "btree"
      },
      {
        "name": "ix_event_vehicle_time",
        "fields": [
          "vehicleId",
          "occurredAt"
        ],
        "unique": false,
        "method": "btree"
      }
    ],
    "constraints": {
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "session_started",
                  "session_confirmed",
                  "warning_10_minutes",
                  "session_expired"
                ]
              }
            }
          },
          "then": {
            "required": [
              "sessionId"
            ],
            "properties": {
              "sessionId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
