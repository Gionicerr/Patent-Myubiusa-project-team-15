  {
    "name": "ImportBatch",
    "description": "ImportBatch",
    "fields": [
      {
        "name": "id",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Внутренний UUID",
        "required": true
      },
      {
        "name": "city",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": "city",
        "required": true
      },
      {
        "name": "sha256",
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "description": "sha256",
        "required": true
      },
      {
        "name": "createdAt",
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "description": "createdAt",
        "required": true
      },
      {
        "name": "status",
        "schema": {
          "type": "string",
          "enum": [
            "pending",
            "completed",
            "failed"
          ]
        },
        "description": "status",
        "required": true
      },
      {
        "name": "accepted",
        "schema": {
          "type": "integer",
          "minimum": 0
        },
        "description": "accepted",
        "required": true
      },
      {
        "name": "quarantined",
        "schema": {
          "type": "integer",
          "minimum": 0
        },
        "description": "quarantined",
        "required": true
      },
      {
        "name": "issues",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "externalZoneId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "row",
              "externalZoneId",
              "code",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "description": "issues",
        "required": true
      }
    ],
    "primary_key": [
      "id"
    ],
    "relations": [],
    "indexes": [
      {
        "name": "ux_import_hash",
        "fields": [
          "city",
          "sha256"
        ],
        "unique": true,
        "method": "btree"
      }
    ]
  },
  {
    "name": "ParkingObject",
    "description": "Объект источника, НЕ подтверждённая тарифная зона. Исходные тарифы и WKT сохраняются; невалидный объект исключается из matching.",
    "fields": [
      {
        "name": "id",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Внутренний UUID",
        "required": true
      },
      {
        "name": "city",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": "city",
        "required": true
      },
      {
        "name": "externalZoneId",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "displayName",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "geometry",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "price",
        "schema": {
          "type": "integer"
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "priceDescription",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "minTime",
        "schema": {
          "type": "integer",
          "minimum": 0
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "timeStep",
        "schema": {
          "type": "integer",
          "minimum": 0
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "tariff",
        "schema": {
          "type": "object",
          "properties": {
            "hasHolidays": {
              "type": "boolean"
            },
            "periods": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "to": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "duration": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "price": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "required": [
                  "from",
                  "to",
                  "duration",
                  "price",
                  "type"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "hasHolidays",
            "periods"
          ],
          "additionalProperties": false
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "entityState",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "initDate",
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "lastSyncedAt",
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "description": "Исходное поле источника без пересчёта",
        "required": true
      },
      {
        "name": "importBatchId",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "importBatchId",
        "required": true
      },
      {
        "name": "geometryGeoJson",
        "schema": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/Geometry"
            },
            {
              "type": "null"
            }
          ],
          "x-db-type": "geometry(Geometry,4326)",
          "x-derived-from": "original geometry WKT; null for quarantine"
        },
        "description": "geometryGeoJson",
        "required": false
      },
      {
        "name": "geometryState",
        "schema": {
          "type": "string",
          "enum": [
            "valid",
            "quarantined"
          ]
        },
        "description": "geometryState",
        "required": true
      }
    ],
    "primary_key": [
      "id"
    ],
    "relations": [
      {
        "field": "importBatchId",
        "target_entity": "ImportBatch",
        "target_field": "id",
        "on_delete": "RESTRICT"
      }
    ],
    "indexes": [
      {
        "name": "ux_source_object",
        "fields": [
          "city",
          "externalZoneId"
        ],
        "unique": true,
        "method": "btree"
      },
      {
        "name": "ix_object_geometry",
        "fields": [
          "geometryGeoJson"
        ],
        "unique": false,
        "method": "gist"
      },
      {
        "name": "ix_object_state",
        "fields": [
          "city",
          "entityState"
        ],
        "unique": false,
        "method": "btree"
      }
    ]
  },
